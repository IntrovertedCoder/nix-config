auto update:
  store current git commit
  git pull
  nh os switch --update (update gets done on one machine [probably a vm] which gets ran a day early for time to debug issues)
  if failed:
    restore to saved git commit, try nh os switch --update
    if failed:
      send notification through unifiedpush (or discord channel) saying update failed (maybe provide error message)
  if succeeded:
    send notification saying update on hostname succeded



