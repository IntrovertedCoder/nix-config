# The UniFi controller (modules/cluster/unifi.nix): a NixOS system container
# on Ceph, directly on the untagged infra segment at 10.4.0.10.
#
# The container is disposable: its state lives on the unifi-data volume
# (/var/lib/unifi). An update = a new image from the flake -> the instance is
# replaced, the volume stays. The app passes the image paths (unifi_image).

variable "unifi_image" {
  description = "The controller's image from the flake (generated by nix run .#tofu)."
  type        = object({ metadata = string, data = string })
}

resource "incus_image" "unifi" {
  source_file = {
    metadata_path = var.unifi_image.metadata
    data_path     = var.unifi_image.data
  }
}

resource "incus_storage_volume" "unifi_data" {
  name         = "unifi-data"
  pool         = "remote"
  content_type = "filesystem"
  config = {
    size = "10GiB"
    # Ceph snapshots: undo a bad update or a wrong click. (Losing Ceph is
    # what the nodes' daily copy of UniFi's own backups is for.)
    "snapshots.schedule" = "@daily"
    "snapshots.expiry"   = "2w"
    "snapshots.pattern"  = "daily-{{ creation_date|date:'2006-01-02' }}"
  }

  # The controller's whole state (MongoDB, settings, backups).
  lifecycle { prevent_destroy = true }
}

resource "incus_instance" "unifi" {
  name     = "unifi"
  image    = incus_image.unifi.fingerprint
  profiles = ["default"] # root disk on remote; evacuate = migrate

  config = {
    "limits.cpu"     = "2"
    "limits.memory"  = "2GiB"
    "boot.autostart" = "true"
  }

  # Untagged on the trunk = infra. Fixed MAC, like the routers' (infra .10).
  device {
    name = "eth0"
    type = "nic"
    properties = {
      nictype = "bridged"
      parent  = "br-trunk"
      hwaddr  = "02:74:af:04:00:0a"
      name    = "eth0"
    }
  }

  device {
    name = "data"
    type = "disk"
    properties = {
      pool   = "remote"
      source = incus_storage_volume.unifi_data.name
      path   = "/var/lib/unifi"
    }
  }
}
