# UniFi OS Server (modules/cluster/unifi-os.nix): a NixOS VM on Ceph,
# directly on the untagged infra segment, beside the old controller
# (unifi.tf) until the switch.
#
# The VM is disposable, like the old controller's container: the console's
# state lives on the unifi-os-data volume (/var/lib/uosserver). An update =
# a new image from the flake -> the instance is replaced, the volume stays.
# The app passes the image paths (unifi_os_image). Its web UI:
# https://10.4.0.11:11443 (from Trusted).

variable "unifi_os_image" {
  description = "The console's VM image from the flake (generated by nix run .#tofu)."
  type        = object({ metadata = string, data = string })
}

resource "incus_image" "unifi_os" {
  source_file = {
    metadata_path = var.unifi_os_image.metadata
    data_path     = var.unifi_os_image.data
  }
}

resource "incus_storage_volume" "unifi_os_data" {
  name         = "unifi-os-data"
  pool         = incus_storage_pool.remote.name
  content_type = "block" # ext4 inside the VM (formatted on first boot)
  config = {
    size = "20GiB"
    # As unifi-data: undo a bad update or a wrong click
    "snapshots.schedule" = "@daily"
    "snapshots.expiry"   = "2w"
    "snapshots.pattern"  = "daily-{{ creation_date|date:'2006-01-02' }}"
  }

  # The console's whole state (podman's storage with its volumes, its id).
  lifecycle { prevent_destroy = true }
}

resource "incus_instance" "unifi_os" {
  name     = "unifi-os"
  type     = "virtual-machine"
  image    = incus_image.unifi_os.fingerprint
  profiles = ["default"] # root disk on remote; evacuate = migrate

  config = {
    "limits.cpu"          = "2"
    "limits.memory"       = "4GiB" # ~2 GiB in use; loading a new console image takes 3
    "boot.autostart"      = "true"
    "migration.stateful"  = "true"  # live around planned reboots, like v1
    "security.secureboot" = "false" # NixOS's systemd-boot isn't signed
  }

  # Untagged on the trunk = infra. The address follows the MAC (unifi-os.nix):
  # :0b is infra .11.
  device {
    name = "eth0"
    type = "nic"
    properties = {
      nictype = "bridged"
      parent  = "br-trunk"
      hwaddr  = "02:74:af:04:00:0b"
      name    = "eth0"
    }
  }

  # The system and the console's image (about 3 GiB)
  device {
    name = "root"
    type = "disk"
    properties = {
      pool = incus_storage_pool.remote.name
      path = "/"
      size = "12GiB"
    }
  }

  # "data": the VM finds it as /dev/disk/by-id/scsi-0QEMU_QEMU_HARDDISK_incus_data
  device {
    name = "data"
    type = "disk"
    properties = {
      pool   = incus_storage_pool.remote.name
      source = incus_storage_volume.unifi_os_data.name
    }
  }
}

# The volume was made by hand first (2026-10-26), holding the console moved
# from the Debian VM it was tried in, and so was the VM: the first apply
# adopts them. The VM is replaced by one from the flake's image (an adopted
# instance has no image to compare), the volume stays: the console restarts
# once. Remove these blocks after that apply.
import {
  to = incus_storage_volume.unifi_os_data
  id = "/remote/unifi-os-data"
}

import {
  to = incus_instance.unifi_os
  id = "unifi-os"
}
