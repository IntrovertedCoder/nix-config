# The Incus cluster's shared objects: the Ceph storage pool, the networks,
# the default profile, and Incus's link to OVN.
#
# What can't be declared stays in the bootstrap apps: forming the cluster
# and joining members (cluster-incus-bootstrap), and the OVN Raft databases
# (cluster-ovn-bootstrap), which then runs `nix run .#tofu -- apply`.
#
# Each member's own part of a clustered pool or network (the pool's `source`,
# transit's `parent`) is join-time state, not declared here: the provider
# can't adopt it, and a member that rejoins (cluster-rebuild) has to supply
# it in its join anyway. The bootstrap apps create those parts ("pending" on
# every member) before the first apply creates the cluster-wide objects.
#
# Values that already live in Nix (members, VLANs, subnets, the ring MTU)
# come from the flake: the app writes them to flake.auto.tfvars.json.

variable "cluster" {
  description = "The cluster's plan from the flake (generated by nix run .#tofu)."
  type = object({
    members      = map(number) # Incus member name -> node id (mesh fd9a:7af:74af:ff::<id>)
    transit_vlan = number
    ring_mtu     = number
    lan = object({
      transit   = object({ v4 = string, v6 = string })
      services  = object({ v4 = string, v6 = string })
      ovnUplink = object({ v4 = string, v6 = string })
    })
  })
}

locals {
  lan = var.cluster.lan
  # Instance traffic between nodes is Geneve over IPv6 on the ring: 78 bytes
  # of headers (IPv6 40, UDP 8, Geneve 8, OVN's metadata option 8, inner
  # Ethernet 14 -- measured: the tunnel reported a path MTU of 1500 - 78).
  # The real ring (65520) fits 1500; the test lab's 1500 does not.
  ovn_mtu = min(var.cluster.ring_mtu - 78, 1500)
  ovn_nb = join(",", [for id in sort(values(var.cluster.members)) :
  "tcp:[fd9a:7af:74af:ff::${id}]:6641"])
}

# ---------------------------------------------------------------- storage
# Every member's part: source=vms (the Ceph pool, made by cluster-ceph-bootstrap).

resource "incus_storage_pool" "remote" {
  name   = "remote"
  driver = "ceph"
  config = {
    "ceph.cluster_name"  = "ceph"
    "ceph.osd.pool_name" = "vms"
    "ceph.osd.pg_num"    = "32"
    "ceph.user.name"     = "admin"
    # exclusive-lock is what fences a partitioned node: the member that heals
    # an instance breaks the lock, which blocklists the old node's RBD client,
    # so its stale copy can't write. Incus' default is "layering" only, and
    # without exclusive-lock a healed instance and its stale copy both write
    # the same disk (seen in testing: real filesystem corruption).
    "ceph.rbd.features" = "layering,exclusive-lock,object-map,fast-diff,deep-flatten"
  }
  # Every instance's disk.
  lifecycle { prevent_destroy = true }
}

# ---------------------------------------------------------------- networks
# incusbr0: a NAT bridge on each node, for test instances and the default
# profile. Nothing outside the node reaches it. (No member part.)

resource "incus_network" "incusbr0" {
  name = "incusbr0"
  description = "NAT bridge on each node, for test instances"
  config = {
    "ipv4.address" = "10.200.0.1/24"
    "ipv4.nat"     = "true"
    "ipv6.address" = "none"
  }
}

# transit: OVN's uplink, VLAN <transit> on each member's br-trunk. The router
# VMs are the gateway; OVN's router gets the pinned address the routers
# route the services network to (modules/cluster/_lan.nix). Every member's
# part: parent=br-trunk.

resource "incus_network" "transit" {
  name = "transit"
  type = "physical"
  config = {
    vlan               = tostring(var.cluster.transit_vlan)
    "ipv4.gateway"     = "${local.lan.transit.v4}.1/24"
    "ipv4.ovn.ranges"  = "${local.lan.ovnUplink.v4}-${local.lan.transit.v4}.19"
    "ipv4.routes"      = "${local.lan.services.v4}.0/24"
    "ipv6.gateway"     = "${local.lan.transit.v6}::1/64"
    "ipv6.ovn.ranges"  = "${local.lan.ovnUplink.v6}-${local.lan.transit.v6}::1f"
    "ipv6.routes"      = "${local.lan.services.v6}::/64"
    "ovn.ingress_mode" = "routed"
    "dns.nameservers"  = "${local.lan.transit.v4}.1"
  }
  lifecycle { prevent_destroy = true }
}

# services: the OVN network for services, routed (no NAT in OVN -- the
# routers NAT once, to the WAN).

resource "incus_network" "services" {
  depends_on = [incus_server.this]
  name       = "services"
  type       = "ovn"
  config = {
    network        = incus_network.transit.name
    "ipv4.address" = "${local.lan.services.v4}.1/24"
    "ipv4.nat"     = "false"
    "ipv6.address" = "${local.lan.services.v6}::1/64"
    "ipv6.nat"     = "false"
    "bridge.mtu"   = tostring(local.ovn_mtu)
    # OVN's router on transit, pinned, so the routers can route the services
    # network to it statically.
    "volatile.network.ipv4.address" = local.lan.ovnUplink.v4
    "volatile.network.ipv6.address" = local.lan.ovnUplink.v6
  }
  lifecycle { prevent_destroy = true }
}

# ---------------------------------------------------------------- server
# Only the keys declared here are OpenTofu's; the rest of the server config
# (addresses, cluster.healing_threshold from incus-healing-arm) is left alone.

resource "incus_server" "this" {
  config = {
    # Every node's OVN Northbound database (modules/cluster/ovn.nix).
    "network.ovn.northbound_connection" = local.ovn_nb
  }
  # Destroying it would unset the key, cutting Incus off from OVN.
  lifecycle { prevent_destroy = true }
}

# ---------------------------------------------------------------- profile

resource "incus_profile" "default" {
  name        = "default"
  description = "Default Incus profile"
  config = {
    # Cold-migrate (stop, move, start) on evacuation -- no live-migration, no
    # CPU-model matching between hosts.
    "cluster.evacuate" = "migrate"
  }
  device {
    name       = "root"
    type       = "disk"
    properties = { path = "/", pool = incus_storage_pool.remote.name }
  }
  device {
    name       = "eth0"
    type       = "nic"
    properties = { name = "eth0", network = incus_network.incusbr0.name }
  }
}
