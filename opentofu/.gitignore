# Working files of OpenTofu, should it ever run here (the app runs it on a node).
.terraform/
# The provider comes from nixpkgs (opentofu.withPlugins), pinned by flake.lock;
# the registry lock file would only go stale on every nixpkgs bump.
.terraform.lock.hcl
# The state is in Ceph; never commit a copy.
*.tfstate
*.tfstate.*
crash.log
# Values the app generates from the flake on every run.
*.auto.tfvars.json
